{
  "info": {
    "name": "Stock Adjustment API - Complete Collection",
    "description": "Complete Postman collection for Stock Adjustment API including bulk adjustments with parent-child structure.\n\n## Overview\nStock adjustments allow you to modify inventory levels with full tracking, approval workflows, and audit trails.\n\n## Key Features\n- **Single Item Adjustments**: Adjust one product at a time\n- **Bulk Adjustments**: Adjust multiple products in one adjustment (parent-child structure)\n- **Approval Workflow**: Draft → Pending → Approved → Applied\n- **Activity Logging**: Full audit trail of all changes\n\n## Adjustment Types\n- `increase`: Add to stock\n- `decrease`: Subtract from stock\n- `set`: Set to exact quantity",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api",
      "type": "string",
      "description": "Base URL for the API"
    },
    {
      "key": "token",
      "value": "YOUR_AUTH_TOKEN_HERE",
      "type": "string",
      "description": "Bearer token for authentication"
    },
    {
      "key": "adjustment_id",
      "value": "",
      "type": "string",
      "description": "ID of a stock adjustment (set after creation)"
    },
    {
      "key": "product_id_1",
      "value": "",
      "type": "string",
      "description": "First product ID for testing"
    },
    {
      "key": "product_id_2",
      "value": "",
      "type": "string",
      "description": "Second product ID for testing"
    },
    {
      "key": "product_id_3",
      "value": "",
      "type": "string",
      "description": "Third product ID for testing"
    },
    {
      "key": "variant_id",
      "value": "",
      "type": "string",
      "description": "Product variant ID for testing"
    },
    {
      "key": "store_id",
      "value": "",
      "type": "string",
      "description": "Store ID for testing"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Bulk Stock Adjustments (Parent-Child)",
      "description": "Create bulk stock adjustments with multiple items grouped under a single adjustment number",
      "item": [
        {
          "name": "Create Bulk Adjustment - Physical Count",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set('adjustment_id', jsonData.data.id);",
                  "    console.log('Saved adjustment_id:', jsonData.data.id);",
                  "}",
                  "",
                  "pm.test('Status is completed or partial', function() {",
                  "    pm.expect(['completed', 'partial']).to.include(jsonData.status);",
                  "});",
                  "",
                  "pm.test('Has adjustment number', function() {",
                  "    pm.expect(jsonData.data.adjustment_number).to.exist;",
                  "});",
                  "",
                  "pm.test('Has items array', function() {",
                  "    pm.expect(jsonData.data.items).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason_type\": \"recount\",\n  \"reason\": \"Physical inventory count - Monthly audit\",\n  \"notes\": \"Conducted by warehouse team during regular monthly count\",\n  \"status\": \"draft\",\n  \"items\": [\n    {\n      \"product_id\": \"{{product_id_1}}\",\n      \"adjustment_type\": \"set\",\n      \"quantity_adjusted\": 45,\n      \"notes\": \"Actual count differs from system\"\n    },\n    {\n      \"product_id\": \"{{product_id_2}}\",\n      \"adjustment_type\": \"set\",\n      \"quantity_adjusted\": 120,\n      \"notes\": \"Found discrepancy during count\"\n    },\n    {\n      \"product_id\": \"{{product_id_3}}\",\n      \"adjustment_type\": \"set\",\n      \"quantity_adjusted\": 85,\n      \"notes\": \"Verified count correct\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/stock-adjustments/bulk",
              "host": ["{{base_url}}"],
              "path": ["stock-adjustments", "bulk"]
            },
            "description": "Create a bulk adjustment for physical inventory count with multiple products set to exact quantities."
          },
          "response": [
            {
              "name": "Success Response",
              "originalRequest": {
                "method": "POST",
                "url": {
                  "raw": "{{base_url}}/stock-adjustments/bulk",
                  "host": ["{{base_url}}"],
                  "path": ["stock-adjustments", "bulk"]
                }
              },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"status\": \"completed\",\n  \"message\": \"Stock adjustment created with 3 items\",\n  \"summary\": {\n    \"total_items_submitted\": 3,\n    \"successful_items\": 3,\n    \"failed_items\": 0\n  },\n  \"data\": {\n    \"id\": \"9ba5ad46-e965-4901-b487-2b984e6cb055\",\n    \"adjustment_number\": \"ADJ-14fafcd8-0009\",\n    \"reason_type\": \"recount\",\n    \"reason\": \"Physical inventory count - Monthly audit\",\n    \"status\": \"draft\",\n    \"total_items\": 3,\n    \"items\": [...]\n  }\n}"
            }
          ]
        },

                      "    var jsonData = pm.response.json();",
                      "    pm.collectionVariables.set(\"stock_count_id\", jsonData.stock_count.id);",
                      "    ",
                      "    // Store item IDs for later use",
                      "    if (jsonData.stock_count.items && jsonData.stock_count.items.length > 0) {",
                      "        pm.collectionVariables.set(\"item_1_id\", jsonData.stock_count.items[0].id);",
                      "    }",
                      "    if (jsonData.stock_count.items && jsonData.stock_count.items.length > 1) {",
                      "        pm.collectionVariables.set(\"item_2_id\", jsonData.stock_count.items[1].id);",
                      "    }",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],

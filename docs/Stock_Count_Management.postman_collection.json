    {
      "key": "base_url",
      "value": "http://localhost:8000/api",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "company_id",
      "value": "14fafcd8-137b-4725-a6e9-7542ad27a6ed",
      "type": "string"
    },
    {
      "key": "store_id",
      "value": "f5c9bb5b-7b2c-4596-958a-0931f9595dac",
      "type": "string"
    },
    {
      "key": "stock_count_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "product_1_id",
      "value": "b93d477d-dee6-4b68-ada1-4d1522ada5a8",
      "type": "string"
    },
    {
      "key": "product_2_id",
      "value": "e1972b65-3e71-48c9-9249-c38388eb6673",

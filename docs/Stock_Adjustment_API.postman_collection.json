{
	"info": {
		"_postman_id": "stock-adjustment-collection-2025",
		"name": "Stock Adjustment API",
		"description": "Complete API collection for Stock Adjustment feature with Activity Tracking.\n\nThis collection includes:\n- Create, read, update, delete stock adjustments\n- Approval and rejection workflow\n- Apply adjustments to inventory\n- Activity tracking and monitoring\n- Statistics and reporting\n\nBase URL: {{base_url}}/api\nAuthentication: Bearer Token",

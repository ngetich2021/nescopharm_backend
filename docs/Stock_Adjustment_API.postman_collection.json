				{
					"name": "Create Stock Adjustment - Damage",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.id) {",
									"        pm.environment.set(\"adjustment_id\", jsonData.data.id);",
									"        pm.environment.set(\"adjustment_number\", jsonData.data.adjustment_number);",
									"        console.log(\"Adjustment ID saved: \" + jsonData.data.id);",
									"        console.log(\"Adjustment Number: \" + jsonData.data.adjustment_number);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"product_id\": \"{{product_id}}\",\n    \"adjustment_type\": \"decrease\",\n    \"reason_type\": \"damage\",\n    \"quantity_adjusted\": 10,\n    \"reason\": \"Product damaged during storage inspection\",\n    \"notes\": \"Found damaged items in warehouse sector A\",\n    \"status\": \"draft\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/stock-adjustments",
